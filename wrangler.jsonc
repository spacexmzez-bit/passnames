{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "passnames",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/parties/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "Setup",
        "class_name": "SetupServer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "SetupServer"
      ]
    }
  ]
}
