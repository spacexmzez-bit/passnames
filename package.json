{
  "name": "passnames",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run test && vite build",
    "dev:worker": "npm run build && wrangler dev",
    "deploy": "wrangler deploy",
    "check:deploy": "npm run build && wrangler deploy --dry-run",
    "test": "node --test engine.test.js ui.test.js room.test.js room-ui.test.js match.test.js"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "partyserver": "0.5.10"
  },
  "devDependencies": {
    "vite": "^7.0.0",
    "wrangler": "^4.0.0",
    "@cloudflare/workers-types": "^4.20260426.1"
  }
}
